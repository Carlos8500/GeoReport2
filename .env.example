# Copia este archivo como .env y ajusta los valores (el .env NO se sube a GitHub).

# Contraseña de PostgreSQL usada por docker-compose.yml (sólo desarrollo)
POSTGRES_PASSWORD=rabiacun_dev

# Secreto para firmar las sesiones (tokens). Usa un texto largo y aleatorio.
# Generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta administradora de prueba: la API la crea o actualiza al arrancar.
# Mínimo 8 caracteres. No uses una contraseña real.
ADMIN_EMAIL=admin@rabiacun.test
ADMIN_PASSWORD=

# Dirección de la API para compilaciones que no usan el proxy de Vite
# (por ejemplo, la APK). Vacío = misma dirección que la página.
# Ejemplos: http://192.168.1.50:4000  ·  https://rabiacun.mi-tunel.com
VITE_API_URL=
