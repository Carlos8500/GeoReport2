                  "pm.test('Rol administrador', () => pm.expect(pm.response.json().user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Mi perfil",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el ciudadano de la sesión', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('citizenEmail')));"
                ]
              }
            }
          ],
