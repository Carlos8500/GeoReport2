          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/incidents?species=zorra_gris&status=verificado_oficial"
          }
        },
        {
          "name": "Registrar reporte (ciudadano, con foto)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('El servidor asigna folio, estado ciudadano y autor', () => {",
                  "  pm.expect(body.folio).to.match(/^CUN-\\d{4}-\\d{4}$/);",
                  "  pm.expect(body.verificationStatus).to.eql('reporte_ciudadano');",
                  "  pm.expect(body.ownerId).to.be.a('string');",
                  "});",
                  "pm.test('Se guardó la foto', () => pm.expect(body.photoUrl).to.match(/\\/api\\/photos\\/\\d+$/));",
                  "pm.collectionVariables.set('incidentId', body.id);",
                  "pm.collectionVariables.set('photoId', body.photoUrl.split('/').pop());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/incidents",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prueba Postman · perro agresivo en Av. Tulum\",\n  \"eventType\": \"mordedura\",\n  \"species\": \"perro\",\n  \"approxLat\": 21.1619,\n  \"approxLng\": -86.8268,\n  \"supermanzana\": \"Centro (SM 1–30)\",\n  \"referenceLandmark\": \"Av. Tulum frente al Palacio Municipal\",\n  \"description\": \"Perro sin placa mordió a un peatón en la banqueta. Reporte de prueba.\",\n  \"gpsVerifiedInSitu\": true,\n  \"gpsVerificationMode\": \"demo_academico\",\n  \"gyroscope\": {\n    \"alpha\": 90,\n    \"beta\": 70,\n    \"gamma\": 0,\n    \"cardinal\": \"E\",\n    \"source\": \"interactivo\"\n  },\n  \"recommendations\": [\n    \"Lava la herida con agua y jabón por 15 min.\"\n  ],\n  \"photoFileName\": \"prueba.png\",\n  \"photoDataUrl\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n}"
            }
