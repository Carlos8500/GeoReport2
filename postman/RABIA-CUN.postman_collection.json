{
  "info": {
    "name": "RABIA-CUN API",
    "description": "Pruebas de la API REST de RABIA-CUN (Express + PostgreSQL en Docker) Consultar es público; enviar, editar y eliminar requiere sesión; verificar y gestionar alertas, rol de administrador.\n\n1. Levanta el backend: `docker compose up -d --build`\n2. Importa esta colección en Postman.\n3. En la pestaña **Variables** de la colección escribe `adminPassword` (la misma de ADMIN_PASSWORD en tu archivo .env). No la guardes en el repositorio.\n4. Usa **Run collection**: cada petición tiene pruebas automáticas.\n\nLa colección registra un ciudadano de prueba con correo aleatorio y lo elimina al final.\nDesde otro equipo de la red cambia `baseUrl` por `http://<IP-de-la-PC>:4000/api`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{citizenToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@rabiacun.test"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "citizenEmail",
      "value": ""
    },
    {
      "key": "citizenPassword",
      "value": "Prueba2026"
    },
    {
      "key": "citizenToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "incidentId",
      "value": ""
    },
    {
      "key": "photoId",
      "value": ""
    },
    {
      "key": "alertId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Estado del servidor",
      "item": [
        {
          "name": "Health check (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('La base de datos está conectada', () => pm.expect(pm.response.json().database).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Visitante: consultar reportes (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve reportes sin los descartados', () => {",
                  "  const list = pm.response.json();",
                  "  pm.expect(list).to.be.an('array');",
                  "  list.forEach((r) => pm.expect(r.verificationStatus).to.not.eql('rechazado'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/incidents",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Visitante: consultar alertas (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alerts",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Visitante: estadísticas (público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/stats",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Visitante: enviar reporte (→ 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Pide iniciar sesión', () => pm.expect(pm.response.json().error).to.include('Inicia sesión'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/incidents",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Intento sin sesión\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Visitante: mis reportes (→ 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/incidents?mine=true",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. Autenticación",
      "item": [
