                  "pm.test('Indica cada campo con error', () => {",
                  "  const d = pm.response.json().details;",
                  "  pm.expect(d).to.have.all.keys('name', 'email', 'password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
