                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/incidents"
          }
        },
        {
          "name": "Consultar reportes filtrados (zorra gris verificados)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Todos cumplen el filtro', () => pm.response.json().forEach((r) => {",
                  "  pm.expect(r.species).to.eql('zorra_gris');",
                  "  pm.expect(r.verificationStatus).to.eql('verificado_oficial');",
                  "}));"
                ]
