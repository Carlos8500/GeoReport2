                  "pm.test('Devuelve token y rol ciudadano', () => {",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.expect(body.user.role).to.eql('ciudadano');",
                  "  pm.expect(body.user).to.not.have.property('password_hash');",
                  "});"
